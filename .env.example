# ─── Base de datos ───────────────────────────────────────
# SQLite (desarrollo)
DATABASE_URL="file:./dev.db"
# PostgreSQL (producción) → descomenta y comenta la de SQLite
# DATABASE_URL="postgresql://usuario:contraseña@localhost:5432/nexusrh"

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio_32chars"
JWT_REFRESH_SECRET="otro_secreto_diferente_para_refresh_tokens_32chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Servidor ────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ─── CORS ────────────────────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
